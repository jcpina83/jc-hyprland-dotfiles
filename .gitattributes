# Normalize text files in Git.
* text=auto eol=lf

*.sh       text eol=lf
*.fish     text eol=lf
*.conf     text eol=lf
*.ini      text eol=lf
*.css      text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.md       text eol=lf
Makefile   text eol=lf

# Binary assets.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.gif      binary