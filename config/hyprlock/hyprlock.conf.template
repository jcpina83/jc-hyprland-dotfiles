# ==============================================================================
# jc-hyprland-dotfiles
# Hyprlock template
#
# Monitor roles:
#   MAIN_OUTPUT      -> authentication screen
#   SECONDARY_OUTPUT -> ambient screen
#
# Colors are injected by:
#   themes/<active-theme>/hyprlock.env
# ==============================================================================


# ==============================================================================
# GENERAL
# ==============================================================================

general {
    hide_cursor = true
    ignore_empty_input = true

    fail_timeout = 1800
}


# ==============================================================================
# BACKGROUNDS
# ==============================================================================


# ------------------------------------------------------------------------------
# Main output
# ------------------------------------------------------------------------------

background {
    monitor = @MAIN_OUTPUT@

    path = screenshot

    blur_passes = 3
    blur_size = 7

    brightness = 0.72
    contrast = 0.92

    vibrancy = 0.16
    vibrancy_darkness = 0.05
}


# ------------------------------------------------------------------------------
# Secondary output
# ------------------------------------------------------------------------------

background {
    monitor = @SECONDARY_OUTPUT@

    path = screenshot

    blur_passes = 3
    blur_size = 7

    brightness = 0.62
    contrast = 0.90

    vibrancy = 0.12
    vibrancy_darkness = 0.05
}


# ==============================================================================
# MAIN OUTPUT
# Authentication screen
# ==============================================================================


# ------------------------------------------------------------------------------
# Clock
# ------------------------------------------------------------------------------

label {
    monitor = @MAIN_OUTPUT@

    text = $TIME

    color = @LOCK_FG@

    font_size = 88
    font_family = JetBrainsMono Nerd Font

    shadow_passes = 2
    shadow_size = 5
    shadow_color = @LOCK_SHADOW@

    position = 0, 190

    halign = center
    valign = center
}


# ------------------------------------------------------------------------------
# Date
# ------------------------------------------------------------------------------

label {
    monitor = @MAIN_OUTPUT@

    text = cmd[update:60000] date "+%A, %d %B %Y"

    color = @LOCK_FG_ALT@

    font_size = 19
    font_family = JetBrainsMono Nerd Font

    position = 0, 110

    halign = center
    valign = center
}


# ------------------------------------------------------------------------------
# User
# ------------------------------------------------------------------------------

label {
    monitor = @MAIN_OUTPUT@

    text =   $USER

    color = @LOCK_PRIMARY@

    font_size = 18
    font_family = JetBrainsMono Nerd Font

    position = 0, 28

    halign = center
    valign = center
}


# ------------------------------------------------------------------------------
# Password
# ------------------------------------------------------------------------------

input-field {
    monitor = @MAIN_OUTPUT@

    size = 330, 58

    outline_thickness = 2

    dots_size = 0.22
    dots_spacing = 0.22
    dots_center = true

    rounding = 18

    outer_color = @LOCK_BORDER_GRADIENT@
    inner_color = @LOCK_INNER@

    font_color = @LOCK_FG@
    font_family = JetBrainsMono Nerd Font

    fade_on_empty = false

    placeholder_text = Password...

    check_color = @LOCK_GREEN@
    fail_color = @LOCK_RED@

    fail_text = <i>$FAIL <b>($ATTEMPTS)</b></i>

    capslock_color = @LOCK_YELLOW@

    shadow_passes = 2
    shadow_size = 8
    shadow_color = @LOCK_SHADOW@

    position = 0, -65

    halign = center
    valign = center
}


# ------------------------------------------------------------------------------
# Keyboard layout
# ------------------------------------------------------------------------------

label {
    monitor = @MAIN_OUTPUT@

    text =   $LAYOUT

    color = @LOCK_MUTED@

    font_size = 13
    font_family = JetBrainsMono Nerd Font

    position = 0, -125

    halign = center
    valign = center
}


# ==============================================================================
# SECONDARY OUTPUT
# Ambient lock screen
# ==============================================================================


# ------------------------------------------------------------------------------
# Theme identity
# ------------------------------------------------------------------------------

label {
    monitor = @SECONDARY_OUTPUT@

    text = ODYSSEY GLASS

    color = @LOCK_PRIMARY@

    font_size = 15
    font_family = JetBrainsMono Nerd Font

    position = 0, 150

    halign = center
    valign = center
}


# ------------------------------------------------------------------------------
# Clock
# ------------------------------------------------------------------------------

label {
    monitor = @SECONDARY_OUTPUT@

    text = $TIME

    color = @LOCK_FG@

    font_size = 64
    font_family = JetBrainsMono Nerd Font

    shadow_passes = 2
    shadow_size = 5
    shadow_color = @LOCK_SHADOW@

    position = 0, 55

    halign = center
    valign = center
}


# ------------------------------------------------------------------------------
# Date
# ------------------------------------------------------------------------------

label {
    monitor = @SECONDARY_OUTPUT@

    text = cmd[update:60000] date "+%A, %d %B"

    color = @LOCK_FG_ALT@

    font_size = 17
    font_family = JetBrainsMono Nerd Font

    position = 0, -10

    halign = center
    valign = center
}


# ------------------------------------------------------------------------------
# Host
# ------------------------------------------------------------------------------

label {
    monitor = @SECONDARY_OUTPUT@

    text = cmd[update:60000] printf "󰌢  %s" "$(hostname)"

    color = @LOCK_MUTED@

    font_size = 14
    font_family = JetBrainsMono Nerd Font

    position = 0, -75

    halign = center
    valign = center
}


# ------------------------------------------------------------------------------
# Session status
# ------------------------------------------------------------------------------

label {
    monitor = @SECONDARY_OUTPUT@

    text = 󰌾  Session locked

    color = @LOCK_GREEN@

    font_size = 13
    font_family = JetBrainsMono Nerd Font

    position = 0, -115

    halign = center
    valign = center
}