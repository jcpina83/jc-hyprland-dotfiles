{
    "name": "jc-main",

    "layer": "top",
    "position": "top",

    "output": "@MAIN_OUTPUT@",

    "height": 42,

    "margin-top": 7,
    "margin-left": 10,
    "margin-right": 10,

    "spacing": 4,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/amd-gpu",
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "tray",
        "idle_inhibitor",
        "custom/control-center",
        "custom/notification",
        "custom/shortcuts",
        "custom/power"
    ],


    // ========================================================================
    // Launcher
    // ========================================================================

    "custom/launcher": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "~/.config/jc-hyprland-dotfiles/bin/launch-wofi.sh --main"
    },


    // ========================================================================
    // Workspaces 1-5
    // ========================================================================

    "hyprland/workspaces": {
        "format": "{name}",

        "all-outputs": false,
        "persistent-only": true,

        "sort-by": "number",

        "persistent-workspaces": {
            "@MAIN_OUTPUT@": [@MAIN_WORKSPACES@]
        },

        "on-click": "activate",

        "tooltip": true
    },


    // ========================================================================
    // Active window
    // ========================================================================

    "hyprland/window": {
        "format": "{}",
        "max-length": 70,
        "separate-outputs": true
    },


    // ========================================================================
    // Clock
    // ========================================================================

    "clock": {
        "interval": 1,

        "format": " {:%H:%M}",
        "format-alt": " {:%A %d %B  •  %H:%M:%S}",

        "tooltip-format":
            "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },


    // ========================================================================
    // AMD GPU
    // ========================================================================

    "custom/amd-gpu": {
        "exec":
            "~/.config/jc-hyprland-dotfiles/bin/amd-gpu.sh",

        "return-type": "json",

        "interval": 2,

        "tooltip": true
    },


    // ========================================================================
    // CPU
    // ========================================================================

    "cpu": {
        "interval": 2,

        "format": " {usage}%",

        "tooltip": true
    },


    // ========================================================================
    // Memory
    // ========================================================================

    "memory": {
        "interval": 2,

        "format": " {percentage}%",

        "tooltip-format":
            "RAM: {used:0.1f} GiB / {total:0.1f} GiB"
    },


    // ========================================================================
    // Audio
    // ========================================================================

    "pulseaudio": {
        "scroll-step": 2,

        "format": "{icon} {volume}%",

        "format-muted": "󰝟 muted",

        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": [
                "",
                "",
                ""
            ]
        },

        "on-click": "pavucontrol",

        "on-click-right":
            "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },


    // ========================================================================
    // Network
    // ========================================================================

    "network": {
        "interval": 3,

        "format-wifi": " {signalStrength}%",

        "format-ethernet": "󰈀",

        "format-disconnected": "󰖪",

        "tooltip-format-wifi":
            "{essid}\n{ipaddr}\nSignal: {signalStrength}%",

        "tooltip-format-ethernet":
            "{ifname}\n{ipaddr}",

        "on-click": "nm-connection-editor"
    },


    // ========================================================================
    // Tray
    // ========================================================================

    "tray": {
        "icon-size": 18,
        "spacing": 7
    },


    // ========================================================================
    // Idle inhibitor
    // ========================================================================

    "idle_inhibitor": {
        "format": "{icon}",

        "format-icons": {
            "activated": "",
            "deactivated": ""
        },

        "tooltip-format-activated":
            "Idle inhibition enabled",

        "tooltip-format-deactivated":
            "Idle inhibition disabled"
    },


    // ========================================================================
    // Control Center
    // ========================================================================

    "custom/control-center": {
        "format": "󰒓",
        "tooltip": true,
        "tooltip-format": "Control Center",
        "on-click": "~/.config/jc-hyprland-dotfiles/bin/jc-control-center toggle-on @MAIN_OUTPUT@"
    },


    // ========================================================================
    // SwayNC
    // ========================================================================

    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },

        "return-type": "json",

        "exec": "swaync-client -swb",

        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",

        "escape": true
    },


    // ========================================================================
    // Power
    // ========================================================================

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "nwgbar"
    },

    "custom/shortcuts": {
        "format": "󰌌",
        "tooltip": true,
        "tooltip-format": "Atajos de teclado\n\nSUPER + 1..0\nCambiar de workspace\n\nSUPER + SHIFT + 1..0\nMover ventana activa\n\nSUPER + ← ↑ ↓ →\nCambiar foco\n\nSUPER + ENTER\nTerminal\n\nSUPER + C\nControl Center\n\nSUPER + T\nSelector de temas\n\nSUPER + SHIFT + E\nMenú de sesión"
    }

}