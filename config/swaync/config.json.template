{
    "ignore-gtk-theme": true,

    "positionX": "right",
    "positionY": "top",

    "control-center-positionX": "right",
    "control-center-positionY": "top",

    "layer": "overlay",
    "layer-shell": true,
    "layer-shell-cover-screen": true,

    "control-center-layer": "overlay",
    "control-center-exclusive-zone": false,

    "control-center-margin-top": 58,
    "control-center-margin-bottom": 10,
    "control-center-margin-right": 10,
    "control-center-margin-left": 10,

    "control-center-width": 460,
    "control-center-height": -1,

    "fit-to-screen": false,

    "cssPriority": "user",

    "notification-window-width": 430,
    "notification-window-height": -1,

    "notification-window-preferred-output": "@MAIN_OUTPUT@",
    "control-center-preferred-output": "@MAIN_OUTPUT@",

    "notification-inline-replies": false,

    "timeout": 8,
    "timeout-low": 5,
    "timeout-critical": 0,

    "keyboard-shortcuts": true,
    "notification-grouping": true,

    "image-visibility": "when-available",

    "transition-time": 180,

    "hide-on-clear": false,
    "hide-on-action": true,

    "text-empty": "No notifications",

    "widgets": [
        "title",
        "dnd",
        "mpris",
        "notifications"
    ],

    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear"
        },

        "dnd": {
            "text": "Do Not Disturb"
        },

        "mpris": {
            "autohide": true,
            "show-album-art": "when-available"
        },

        "notifications": {
            "vexpand": true
        }
    }
}