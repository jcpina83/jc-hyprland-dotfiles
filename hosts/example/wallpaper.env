# ==============================================================================
# jc-hyprland-dotfiles
# Global wallpaper configuration
#
# This file is copied to:
#
#   ~/.config/jc-hyprland-dotfiles/local/wallpaper.env
#
# Machine-local configuration. Never commit the local copy.
# ==============================================================================

# ------------------------------------------------------------------------------
# Wallpaper backend
#
# auto       Prefer awww and fall back to hyprpaper.
# awww       Force animated wallpaper backend.
# hyprpaper  Force Hyprland-native static backend.
# ------------------------------------------------------------------------------

WALLPAPER_ENGINE=auto


# ------------------------------------------------------------------------------
# User wallpaper library
# ------------------------------------------------------------------------------

WALLPAPER_LIBRARY_DIR="$HOME/Pictures/Wallpapers"


# ------------------------------------------------------------------------------
# Transition preset
#
# theme  Use the transition personality defined by the active theme.
# ------------------------------------------------------------------------------

WALLPAPER_TRANSITION_PRESET=theme

# Optional explicit overrides.
# Leave commented to use the selected preset values.
#
# WALLPAPER_TRANSITION_TYPE=fade
# WALLPAPER_TRANSITION_DURATION=1.2
# WALLPAPER_TRANSITION_FPS=60
