# ==============================================================================
# jc-hyprland-dotfiles
# Example host configuration
#
# This file contains example values only.
# The installer copies it to:
#
#   ~/.config/jc-hyprland-dotfiles/local/host.env
#
# Configure the copied file for the target machine.
# ==============================================================================

PROFILE=desktop
THEME=odyssey-glass

# Logical monitor roles
MAIN_OUTPUT=DP-1
SECONDARY_OUTPUT=DP-2

# Workspace roles
MAIN_WORKSPACES=1,2,3,4,5
SECONDARY_WORKSPACES=6,7,8,9,10

# Optional dedicated AMD GPU PCI address.
# Determine it on the target machine before enabling:
#
# GPU_PCI=0000:00:00.0