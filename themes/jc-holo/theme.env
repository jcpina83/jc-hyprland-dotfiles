# ==============================================================================
# jc-hyprland-dotfiles
# Theme: JC Holo
#
# H1.2 visual foundation.
# Wallpaper assets are temporary placeholders copied from Cyber Noir and are
# replaced by the dedicated JC Holo wallpaper pack in H1.3.
# ==============================================================================

THEME_ID=jc-holo
THEME_NAME="JC Holo"

MAIN_WALLPAPER="wallpapers/main.webp"
SECONDARY_WALLPAPER="wallpapers/secondary.webp"

MAIN_WALLPAPER_FIT=cover
SECONDARY_WALLPAPER_FIT=cover

# H1.2 does not add a new wallpaper runtime preset.
# Keep the existing backend contract and use the canonical fade preset.
THEME_WALLPAPER_TRANSITION_PRESET=default
